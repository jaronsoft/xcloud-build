<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="27000" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="launch-view-controller">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="27000"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="Named colors" minToolsVersion="9.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="launch-scene">
            <objects>
                <viewController id="launch-view-controller" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="launch-root-view">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <view contentMode="scaleToFill" clipsSubviews="YES" translatesAutoresizingMaskIntoConstraints="NO" id="launch-icon-container">
                                <rect key="frame" x="140.5" y="344" width="112" height="112"/>
                                <subviews>
                                    <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" image="LaunchBrandTransparent" translatesAutoresizingMaskIntoConstraints="NO" id="launch-brand-icon">
                                        <rect key="frame" x="0.0" y="0.0" width="112" height="112"/>
                                    </imageView>
                                </subviews>
                                <color key="backgroundColor" name="LaunchBackground"/>
                                <constraints>
                                    <constraint firstItem="launch-brand-icon" firstAttribute="leading" secondItem="launch-icon-container" secondAttribute="leading" id="icon-leading"/>
                                    <constraint firstAttribute="trailing" secondItem="launch-brand-icon" secondAttribute="trailing" id="icon-trailing"/>
                                    <constraint firstItem="launch-brand-icon" firstAttribute="top" secondItem="launch-icon-container" secondAttribute="top" id="icon-top"/>
                                    <constraint firstAttribute="bottom" secondItem="launch-brand-icon" secondAttribute="bottom" id="icon-bottom"/>
                                    <constraint firstAttribute="width" constant="112" id="container-width"/>
                                    <constraint firstAttribute="height" constant="112" id="container-height"/>
                                </constraints>
                            </view>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="AIS 产品智造" textAlignment="center" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="launch-brand-name">
                                <rect key="frame" x="120" y="474" width="153" height="29"/>
                                <fontDescription key="fontDescription" type="system" weight="semibold" pointSize="22"/>
                                <color key="textColor" red="0.13" green="0.19" blue="0.22" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                <nil key="highlightedColor"/>
                            </label>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="launch-safe-area"/>
                        <color key="backgroundColor" name="LaunchBackground"/>
                        <constraints>
                            <constraint firstItem="launch-icon-container" firstAttribute="centerX" secondItem="launch-root-view" secondAttribute="centerX" id="container-center-x"/>
                            <constraint firstItem="launch-icon-container" firstAttribute="centerY" secondItem="launch-root-view" secondAttribute="centerY" constant="-26" id="container-center-y"/>
                            <constraint firstItem="launch-brand-name" firstAttribute="top" secondItem="launch-icon-container" secondAttribute="bottom" constant="18" id="name-top"/>
                            <constraint firstItem="launch-brand-name" firstAttribute="centerX" secondItem="launch-root-view" secondAttribute="centerX" id="name-center-x"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="launch-first-responder" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="55" y="373"/>
        </scene>
    </scenes>
    <resources>
        <image name="LaunchBrandTransparent" width="418" height="418"/>
        <namedColor name="LaunchBackground">
            <color red="0.94" green="0.95" blue="0.94" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
    </resources>
</document>
