<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="13122.16" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="MOSA-launch-controller">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="13104.12"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="MOSA-launch-scene">
            <objects>
                <viewController id="MOSA-launch-controller" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="MOSA-launch-view">
                        <rect key="frame" x="0.0" y="0.0" width="375" height="667"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" image="LaunchArtwork" translatesAutoresizingMaskIntoConstraints="NO" id="MOSA-launch-artwork">
                                <rect key="frame" x="-22.5" y="123.5" width="420" height="420"/>
                            </imageView>
                        </subviews>
                        <color key="backgroundColor" name="LaunchBackground"/>
                        <constraints>
                            <constraint firstItem="MOSA-launch-artwork" firstAttribute="centerX" secondItem="MOSA-launch-view" secondAttribute="centerX" id="MOSA-launch-center-x"/>
                            <constraint firstItem="MOSA-launch-artwork" firstAttribute="centerY" secondItem="MOSA-launch-view" secondAttribute="centerY" id="MOSA-launch-center-y"/>
                            <constraint firstItem="MOSA-launch-artwork" firstAttribute="width" constant="420" id="MOSA-launch-width"/>
                            <constraint firstItem="MOSA-launch-artwork" firstAttribute="height" constant="420" id="MOSA-launch-height"/>
                        </constraints>
                        <viewLayoutGuide key="safeArea" id="MOSA-launch-safe-area"/>
                    </view>
